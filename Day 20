import time

def usingwhile():
    i=0
    while i<51000:
        i=i+1
        print(i)

def usingfor():
    for i in range(50001):
        print(i)

init=time.time()
usingwhile()
t1=time.time()-init
init=time.time()
usingfor()
print(time.time()-init)
