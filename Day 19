#single inheritance

#where a class inherits properties and behaviours from a single parent class

#simplest form of inheritance

class Animal:
        def __init__(self,name,species):
                self.name=name 
                self.species=species
        def make_sound(self):
                print("sound made by the animal")
class Dog(Animal):
        def __init__(self, name, breed):
                Animal.__init__(self,name, species=Dog)
                self.breed=breed

        def make_sound(self):
                print("bark")

d=Dog("dog","doggerman")
d.make_sound()

a=Animal("dog","dog")
a.make_sound()

